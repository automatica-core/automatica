<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>1.0.0.0</Version>
    <AutomaticaCoreVersion>10.0.0.2049</AutomaticaCoreVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="automatica-manifest.json" />
    <EmbeddedResource Include="automatica-manifest.json" />
    <EmbeddedResource Include="Resources\Mammotion-de.json" />
    <EmbeddedResource Include="Resources\Mammotion-en.json" />
    <InternalsVisibleTo Include="P3.Driver.Mammotion.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Automatica.Core.Driver" Version="$(AutomaticaCoreVersion)" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>
</Project>
