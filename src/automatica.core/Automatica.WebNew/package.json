{
  "name": "automatica-web",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run generate-license",
    "start": "ng s --configuration=development  --host=0.0.0.0 --port=8100",
    "prestart-dev": "npm run generate-license",
    "start-dev": "ng b --watch --configuration=development",
    "prebuild": "npm run generate-license",
    "build": "ng build --configuration=development,dist",
    "prebuild-docker": "npm run generate-license",
    "build-docker": "ng build --configuration=production,dist",
    "prebuild-prod": "npm run generate-license",
    "build-prod": "ng build --configuration=production,dist",
    "test": "ng test",
    "test:headless": "ng test --browsers=ChromeHeadless --watch=false",
    "test:i18n": "node tools/check-templates.mjs",
    "test:i18n-plugins": "node tools/check-plugin-i18n.mjs",
    "build-themes": "devextreme build",
    "set-version": "json -I -f package.json -e \"this.version='$VERSION'\"",
    "ionic:build": "npm run build-prod",
    "ionic:serve": "npm run start",
    "generate-license": "devextreme-license --out src/devextreme-license.ts --force"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fortawesome/angular-fontawesome": "^0.14.0",
    "@fortawesome/fontawesome-free": "^6.4.2",
    "@fortawesome/fontawesome-pro": "^6.4.2",
    "@fortawesome/fontawesome-svg-core": "^6.4.2",
    "@fortawesome/free-regular-svg-icons": "^6.4.2",
    "@fortawesome/free-solid-svg-icons": "^6.4.2",
    "@fortawesome/pro-duotone-svg-icons": "^6.4.2",
    "@fortawesome/pro-solid-svg-icons": "^6.4.2",
    "@microsoft/signalr": "^10.0.11",
    "angular-l10n": "^17.0.1",
    "angular-split": "^20.0.0",
    "color-convert": "^2.0.1",
    "core-js": "^3.51.0",
    "devextreme": "26.1.6",
    "devextreme-angular": "26.1.6",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "moment": "^2.31.0",
    "ng-dynamic-component": "^11.0.0",
    "ngx-cookie-service": "^22.0.0",
    "ngx-device-detector": "^12.0.0",
    "p3root-angular-dnd": "^17.0.1",
    "rxjs": "^7.8.2",
    "semver": "^7.8.6",
    "tslib": "^2.9.1",
    "uuid": "^13.0.2",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/language-service": "^22.2.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@types/jasmine": "^5.1.15",
    "@types/node": "^22.20.5",
    "acorn": "^8.8.2",
    "copyfiles": "^2.4.1",
    "devextreme-cldr-data": "^1.0.3",
    "devextreme-cli": "^1.18.0",
    "devextreme-schematics": "^1.18.0",
    "devextreme-themebuilder": "26.1.6",
    "globalize": "^1.7.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.13.0",
    "jasmine-spec-reporter": "~7.0.0",
    "json": "^11.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "p3root-angular-dnd": {
      "@angular/core": "$@angular/core"
    },
    "@fortawesome/angular-fontawesome": {
      "@angular/core": "$@angular/core"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
