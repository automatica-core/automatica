{
  "name": "automatica-satellite",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run generate-license",
    "start": "ng build --watch --configuration=development",
    "prebuild": "npm run generate-license",
    "build": "ng build",
    "prebuild-docker": "npm run generate-license",
    "build-docker": "ng build --configuration=production",
    "build-themes": "devextreme build",
    "set-version": "json -I -f package.json -e \"this.version='$VERSION'\"",
    "generate-license": "devextreme-license --out src/devextreme-license.ts --force"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "devextreme": "26.1.6",
    "devextreme-angular": "26.1.6",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^22.20.5",
    "devextreme-cli": "^1.18.0",
    "devextreme-themebuilder": "26.1.6",
    "typescript": "~6.0.2"
  }
}
