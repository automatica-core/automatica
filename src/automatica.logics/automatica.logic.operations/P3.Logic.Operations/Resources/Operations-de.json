        "SOC": { "DESCRIPTION": "Ladezustand der Batterie in %" },
        "ENABLE": { "DESCRIPTION": "0 schaltet alle automatischen Verbraucher aus (nicht verbunden = 1)" },
        "LOAD": { "MANUAL": { "DESCRIPTION": "1 = Verbraucher mit voller Leistung ein (Hand), außerhalb des Budgets" }, "LOCK": { "DESCRIPTION": "1 = Verbraucher aus und gesperrt (hat Vorrang vor Hand)" } }
      },
      "OUTPUT": {
        "AVAILABLE": { "DESCRIPTION": "Für die Verbraucher verfügbare Leistung in kW (Überschuss - Reserve + deren eigene Leistung)" },
