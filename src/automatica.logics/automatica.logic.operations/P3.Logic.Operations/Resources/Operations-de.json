        "LOAD": { "SWITCH": { "DESCRIPTION": "Verbraucher ein/aus" }, "SETPOINT": { "DESCRIPTION": "Leistungssollwert in kW (analoge Verbraucher zwischen Einschalt- und Maximalleistung, 0 = aus)" } }
