    "ENERGY": { "NAME": "Energy management" },
    "ENERGY_MANAGER": {
      "NAME": "Energy manager",
      "DESCRIPTION": "Uses the PV surplus: switches up to 12 loads on and off by priority, with hysteresis, delays and minimum on/off times. Analog loads get a power setpoint.",
      "INPUT": {
        "GRID": { "DESCRIPTION": "Grid power in kW: + import, - export (see \"Invert grid\")" },
        "SURPLUS": { "DESCRIPTION": "Surplus in kW (+ = surplus), measured with the managed loads running. Used instead of the grid power" },
        "BATTERY": { "DESCRIPTION": "Battery power in kW: + charging, - discharging. At or above the minimum SoC the charging power is used for loads" },
        "SOC": { "DESCRIPTION": "Battery state of charge in %" },
        "ENABLE": { "DESCRIPTION": "0 switches all automatic loads off (unlinked = 1)" },
        "LOAD": { "MANUAL": { "DESCRIPTION": "1 = load on at full power (manual), outside the manager's budget" }, "LOCK": { "DESCRIPTION": "1 = load off and locked (wins over manual)" } }
      },
      "OUTPUT": {
        "AVAILABLE": { "DESCRIPTION": "Power in kW available for the managed loads (surplus - reserve + their own power)" },
        "ALLOCATED": { "DESCRIPTION": "Power in kW of the loads the manager runs" },
        "LOAD": { "SWITCH": { "DESCRIPTION": "Load on/off" }, "SETPOINT": { "DESCRIPTION": "Power setpoint in kW (analog loads between switch-on and max power, 0 = off)" } }
      },
      "INVERT_GRID": { "NAME": "Invert grid", "DESCRIPTION": "On: positive grid power means export" },
      "RESERVE": { "NAME": "Reserve (kW)", "DESCRIPTION": "Power kept as a buffer, never given to loads" },
      "HYSTERESIS": { "NAME": "Hysteresis (kW)", "DESCRIPTION": "A load switches on with switch-on power + hysteresis spare, loads are shed when the import exceeds the hysteresis" },
      "ON_DELAY": { "NAME": "Switch-on delay (s)", "DESCRIPTION": "How long the surplus must last before a load switches on, also the time between two switch-ons" },
      "OFF_DELAY": { "NAME": "Switch-off delay (s)", "DESCRIPTION": "How long the import must last before loads are shed" },
      "MODULATION_INTERVAL": { "NAME": "Modulation interval (s)", "DESCRIPTION": "Analog setpoints rise at most once per interval, they drop at once" },
      "MIN_SOC": { "NAME": "Minimum battery SoC (%)", "DESCRIPTION": "Below this SoC the battery charges first and no load is switched on" },
      "LOAD": {
        "PRIORITY": { "DESCRIPTION": "1 = highest priority" },
        "ON_POWER": { "DESCRIPTION": "Power of the load in kW (analog loads: minimum power). 0 = load not used" },
        "MAX_POWER": { "DESCRIPTION": "Maximum power in kW (analog loads only)" },
        "TYPE": { "DESCRIPTION": "Digital: on/off. Analog: on/off and a power setpoint", "DIGITAL": "Digital", "ANALOG": "Analog" },
