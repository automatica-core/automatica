      "OUTPUT": { "OVERLOAD": { "DESCRIPTION": "1 while the total power is above max power" }, "RESERVE": { "DESCRIPTION": "Power in kW left until max power (negative = overload)" }, "LOCK": { "DESCRIPTION": "1 = load locked (shed)" } },
      "MAX_POWER": { "NAME": "Max power (kW)", "DESCRIPTION": "Maximum total power, can be linked" },
      "HYSTERESIS": { "NAME": "Hysteresis (kW)", "DESCRIPTION": "A load is released only if the total power plus its power stays this far below max power" },
